# Application
PORT=3000
NODE_ENV=development
AUTO_MIGRATE=true
LOG_SILENT=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering_db
DB_DEBUG=false

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# Background Workers
DISABLE_BACKGROUND_WORKERS=false
OUTBOX_POLL_INTERVAL_MS=500
PENDING_REF_POLL_INTERVAL_MS=500
SQS_POLL_INTERVAL_MS=500
